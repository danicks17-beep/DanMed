{
  "manifest_version": 3,
  "name": "DanMed",
  "version": "5.0",
  "description": "DanMed workflow shortcuts and ModMed enhancements.",
  "permissions": ["storage"],
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.modmedapp.com/ema/web/practice/staff/*"],
      "js": ["content.js", "danmed-features.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
